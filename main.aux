\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Comparative analysis of memory consumption across the three sampling strategies for a batch of $10^6$ items. The \texttt  {heapcy} (Custom-heap) implementation demonstrates a $\sim 87.47\%$ reduction in memory usage compared to the baseline \texttt  {Pure Python} approach. This drastic drop is attributed to the file-offset mechanism (Section \ref {customheap}), which eliminates the overhead of storing string objects in RAM The reduction in memory is not only an efficiency gain it changes the problem class from 'requires a supercomputer' to 'runs on a laptop'.}}{19}{figure.caption.5}\protected@file@percent }
\newlabel{fig:1}{{1}{19}{Comparative analysis of memory consumption across the three sampling strategies for a batch of $10^6$ items. The \texttt {heapcy} (Custom-heap) implementation demonstrates a $\sim 87.47\%$ reduction in memory usage compared to the baseline \texttt {Pure Python} approach. This drastic drop is attributed to the file-offset mechanism (Section \ref {customheap}), which eliminates the overhead of storing string objects in RAM The reduction in memory is not only an efficiency gain it changes the problem class from 'requires a supercomputer' to 'runs on a laptop'}{figure.caption.5}{}}
\newlabel{fig:1@cref}{{[figure][1][6]1}{[1][19][]19}{}{}{}}
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Size occupied in MB for $10^x$ amount of items by each implementation, this tells us how good the optimizations are instead of the old implementation}}{19}{table.caption.6}\protected@file@percent }
\newlabel{tab:1}{{1}{19}{Size occupied in MB for $10^x$ amount of items by each implementation, this tells us how good the optimizations are instead of the old implementation}{table.caption.6}{}}
\newlabel{tab:1@cref}{{[table][1][6]1}{[1][19][]19}{}{}{}}
